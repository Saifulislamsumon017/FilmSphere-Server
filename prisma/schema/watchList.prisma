model Watchlist {
  id        String   @id @default(uuid())

  userId    String
  movieId   String

  addedAt   DateTime @default(now())

  // 🔗 Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // 🚀 Constraints
  @@unique([userId, movieId], name: "uniq_user_movie_watchlist")

  // 🚀 Indexing
  @@index([userId], name: "idx_watchlist_user")
  @@index([movieId], name: "idx_watchlist_movie")

  // 🔥 Composite index (very useful)
  @@index([userId, addedAt], name: "idx_watchlist_user_added")

  // 📦 Table mapping (fixed naming)
  @@map("watchlists")
}