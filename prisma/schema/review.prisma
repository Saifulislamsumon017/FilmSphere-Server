model Review {
  id        String         @id @default(uuid())

  title     String
  rating Float
  content   String         @db.Text

  status    ReviewStatus   @default(PENDING)
  rejectionReason String?

  hasSpoiler Boolean       @default(false)
  tags      String[]       @default([])


  likesCount   Int         @default(0)
  commentCount Int         @default(0)

  // 🔥 Soft delete (consistency)
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?

  userId    String
  movieId   String

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // 🔗 Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  comments  Comment[]
  likes     Like[]

  // 🚀 Constraints
  @@unique([userId, movieId], name: "uniq_user_movie_review")

  // 🚀 Indexing 
  @@index([userId], name: "idx_review_user")
  @@index([movieId], name: "idx_review_movie")
  @@index([status], name: "idx_review_status")
  @@index([isDeleted], name: "idx_review_is_deleted")

  // 🔥 Composite index (very useful)
  @@index([movieId, status], name: "idx_review_movie_status")

  // 📦 Table mapping
  @@map("reviews")
}