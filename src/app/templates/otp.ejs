<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <title>Your OTP Code</title>
</head>

<body style="margin:0; padding:0; background:#f3f4f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding:50px 0;">

        <!-- Card -->
        <table width="100%" cellpadding="0" cellspacing="0"
          style="max-width:600px; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 10px 25px rgba(0,0,0,0.1);">

          <!-- Header -->
          <tr>
            <td align="center" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); padding:40px;">
              <h1 style="color:#ffffff; margin:0; font-size:24px; font-weight:700;">
                OTP Verification
              </h1>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:40px; text-align:center;">

              <!-- Greeting -->
              <h2 style="margin:0; color:#111827; font-size:20px;">
                Hello <%= name %> 👋
              </h2>

              <p style="color:#6b7280; font-size:16px; margin:20px 0 30px;">
                Use the One-Time Password below to continue.
              </p>

              <!-- OTP -->
              <div
                style="display:inline-block; background:#111827; color:#ffffff; font-size:32px; font-weight:700; letter-spacing:8px; padding:20px 50px; border-radius:12px; box-shadow:0 0 15px #7c3aed, 0 5px 15px rgba(0,0,0,0.1); margin-bottom:25px;">
                <%= otp %>
              </div>

              <!-- Expiry -->
              <p style="color:#dc2626; font-size:15px; font-weight:600; margin:10px 0 30px;">
                ⏱️ This OTP will expire in 10 minutes.
              </p>

              <!-- ✅ SAFE VERIFY BUTTON -->
              <% if (typeof verifyUrl !=='undefined' && verifyUrl) { %>
                <a href="<%= verifyUrl %>"
                  style="display:inline-block; background:#4f46e5; color:#ffffff; text-decoration:none; font-weight:600; padding:14px 35px; border-radius:8px; box-shadow:0 5px 15px rgba(79,70,229,0.3); margin-bottom:25px;">
                  ✅ Continue
                </a>
                <% } %>

                  <!-- Footer Text -->
                  <p style="color:#9ca3af; font-size:14px; margin-top:35px;">
                    Please do not share this code with anyone.<br />
                    If you did not request this, you can safely ignore this email.
                  </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:25px; background:#f9fafb;">
              <p style="margin:0; font-size:12px; color:#9ca3af;">
                © 2026 Your App. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>

</html>